{
  "name": "@revendo/target-site",
  "version": "1.0.0",
  "private": true,
  "description": "Vitrine — a fake resale marketplace guarded by Sentinelle, a miniature bot-detection engine.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx dist_test_shim.ts 2>/dev/null || tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2"
  }
}
