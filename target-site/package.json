{
  "name": "@revendo/target-site",
  "version": "1.0.0",
  "private": true,
  "description": "Vitrine — a fake resale marketplace guarded by Sentinelle, a miniature bot-detection engine.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx dist_test_shim.ts 2>/dev/null || tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
